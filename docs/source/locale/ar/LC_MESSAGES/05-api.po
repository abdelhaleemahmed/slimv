#: ac6dc1c5013b4ae2aa06899f2ee75f7f of slimv:1
msgid "slimv — a video analysis & re-encoding toolkit."
msgstr ""

#: 91cd0a1dcb5e41088a54e32dd705a7fa of slimv:3
msgid ""
"Shrink video files without losing visible quality. slimv orchestrates "
"ffmpeg/ ffprobe to inspect hardware, analyze a library, benchmark "
"encoders on your own content, apply quality-preserving profiles, and "
"verify outputs before you delete any source."
msgstr ""

